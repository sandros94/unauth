{
  "name": "unauth",
  "version": "0.0.1",
  "description": "Low-level OIDC utilities",
  "repository": "sandros94/unauth",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "author": {
    "name": "Sandro Circi",
    "email": "sandro.circi@digitoolmedia.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./oauth": {
      "types": "./dist/oauth.d.mts",
      "default": "./dist/oauth.mjs"
    },
    "./oauth/internal": {
      "types": "./dist/oauth/internal.d.mts",
      "default": "./dist/oauth/internal.mjs"
    },
    "./oidc": {
      "types": "./dist/oidc.d.mts",
      "default": "./dist/oidc.mjs"
    },
    "./oidc/internal": {
      "types": "./dist/oidc/internal.d.mts",
      "default": "./dist/oidc/internal.mjs"
    },
    "./utils": {
      "types": "./dist/utils.d.mts",
      "default": "./dist/utils.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "node --experimental-strip-types --watch ./playground/main.ts",
    "lint": "eslint . && prettier -c .",
    "lint:fix": "automd && eslint . --fix && prettier -w .",
    "prepack": "pnpm build",
    "release": "pnpm test && pnpm prepack && changelogen --release --push --publish",
    "test": "pnpm lint && pnpm test:types && vitest run --slowTestThreshold=500",
    "test:coverage": "pnpm lint && pnpm test:types && vitest run --coverage --slowTestThreshold=500",
    "test:types": "tsc --noEmit --skipLibCheck",
    "bench": "vitest bench --run"
  },
  "resolutions": {
    "unauth": "link:."
  },
  "dependencies": {
    "unjwt": "^0.5.14",
    "unsecure": "^0.0.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-v8": "^3.2.4",
    "automd": "^0.4.0",
    "changelogen": "^0.6.2",
    "eslint": "^9.34.0",
    "eslint-config-unjs": "^0.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "unbuild": "^3.6.1",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher"
    ]
  },
  "packageManager": "pnpm@10.15.0"
}
