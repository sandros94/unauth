{
  "name": "unauth",
  "version": "0.0.5",
  "description": "Low-level OIDC utilities",
  "license": "MIT",
  "author": {
    "name": "Sandro Circi",
    "email": "sandro.circi@digitoolmedia.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sandros94/unauth.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./basic": {
      "types": "./dist/basic.d.mts",
      "default": "./dist/basic.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "obuild",
    "dev": "node --watch ./playground/main.ts",
    "dev:prepare": "obuild --stub",
    "lint": "oxlint . && oxfmt --check .",
    "fmt": "automd && oxlint --fix . && oxfmt .",
    "prepack": "pnpm build",
    "release": "pnpm test && pnpm prepack && changelogen --release --push",
    "test": "vitest run --slowTestThreshold=1000",
    "test:coverage": "vitest run --coverage --slowTestThreshold=1000",
    "typecheck": "tsgo --noEmit",
    "bench": "vitest bench --run"
  },
  "dependencies": {
    "unjwt": "^0.5.39",
    "unsecure": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/supertest": "^7.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260322.1",
    "@vitest/coverage-v8": "^4.1.0",
    "automd": "^0.4.3",
    "changelogen": "^0.6.2",
    "h3v1": "npm:h3@^1.15.10",
    "h3v2": "npm:h3@^2.0.1-rc.18",
    "obuild": "^0.4.32",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "h3": "^1.15.4 || >=2.0.1-rc.18 || ^2.0.1"
  },
  "peerDependenciesMeta": {
    "h3": {
      "optional": true
    }
  },
  "resolutions": {
    "unauth": "link:."
  },
  "engines": {
    "node": "^22.12 || >=24"
  },
  "packageManager": "pnpm@10.32.1"
}
