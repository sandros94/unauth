{
  "name": "unauth",
  "version": "0.0.8",
  "description": "Low-level OIDC utilities",
  "license": "MIT",
  "author": {
    "name": "Sandro Circi",
    "email": "sandro.circi@digitoolmedia.com"
  },
  "repository": "sandros94/unauth",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./n": {
      "types": "./dist/n/index.d.mts",
      "default": "./dist/n/index.mjs"
    },
    "./n/providers/*": {
      "types": "./dist/n/providers/*.d.mts",
      "default": "./dist/n/providers/*.mjs"
    },
    "./error": {
      "types": "./dist/error.d.mts",
      "default": "./dist/error.mjs"
    },
    "./argon2": {
      "types": "./dist/argon2.d.mts",
      "default": "./dist/argon2.mjs"
    }
  },
  "scripts": {
    "build": "obuild",
    "stub": "obuild --stub",
    "dev": "pnpm --dir playgrounds/h3 dev",
    "dev:nuxt": "pnpm --dir playgrounds/nuxt-4 dev",
    "dev:nitro": "pnpm --dir playgrounds/nitro dev",
    "dev:prepare": "obuild --stub && pnpm --dir playgrounds/nuxt-4 prepare && pnpm simple-git-hooks",
    "lint": "oxlint --deny-warnings . && oxfmt --check .",
    "fmt": "automd && oxlint --fix . && oxfmt .",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "bench": "vitest bench --run",
    "typecheck:playgrounds": "tsc -p playgrounds/h3 && tsc -p playgrounds/nitro && pnpm --dir playgrounds/nuxt-4 typecheck"
  },
  "dependencies": {
    "unsecure": "^0.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "automd": "^0.4.3",
    "h3": "^2.0.5",
    "obuild": "^0.4.45",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "rolldown": "1.2.14",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "unjwt": "catalog:",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "unjwt": "^0.8.3"
  },
  "peerDependenciesMeta": {
    "unjwt": {
      "optional": true
    }
  },
  "resolutions": {
    "unauth": "link:."
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm stub && pnpm lint && pnpm typecheck"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.17.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.11.2"
}
