{
  "name": "unauth",
  "version": "0.0.5",
  "description": "Low-level OIDC utilities",
  "repository": "sandros94/unauth",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "author": {
    "name": "Sandro Circi",
    "email": "sandro.circi@digitoolmedia.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./oauth": {
      "types": "./dist/oauth.d.mts",
      "default": "./dist/oauth.mjs"
    },
    "./oidc": {
      "types": "./dist/oidc.d.mts",
      "default": "./dist/oidc.mjs"
    },
    "./utils": {
      "types": "./dist/utils.d.mts",
      "default": "./dist/utils.mjs"
    },
    "./adapters/h3": {
      "types": "./dist/adapters/h3v1.d.mts",
      "default": "./dist/adapters/h3v1.mjs"
    },
    "./adapters/h3/oauth": {
      "types": "./dist/adapters/h3v1/oauth.d.mts",
      "default": "./dist/adapters/h3v1/oauth.mjs"
    },
    "./adapters/h3/oidc": {
      "types": "./dist/adapters/h3v1/oidc.d.mts",
      "default": "./dist/adapters/h3v1/oidc.mjs"
    },
    "./adapters/h3v1": {
      "types": "./dist/adapters/h3v1.d.mts",
      "default": "./dist/adapters/h3v1.mjs"
    },
    "./adapters/h3v1/oauth": {
      "types": "./dist/adapters/h3v1/oauth.d.mts",
      "default": "./dist/adapters/h3v1/oauth.mjs"
    },
    "./adapters/h3v1/oidc": {
      "types": "./dist/adapters/h3v1/oidc.d.mts",
      "default": "./dist/adapters/h3v1/oidc.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "npx --yes listhen -w ./playground/main.ts",
    "dev:v2": "node --experimental-strip-types --watch ./playground/main-v2.ts",
    "lint": "eslint . && prettier -c .",
    "lint:fix": "automd && eslint . --fix && prettier -w .",
    "prepack": "pnpm build",
    "release": "pnpm test && pnpm prepack && changelogen --release --push --publish",
    "test": "pnpm lint && pnpm test:types && vitest run --slowTestThreshold=500",
    "test:coverage": "pnpm lint && pnpm test:types && vitest run --coverage --slowTestThreshold=500",
    "test:types": "tsc --noEmit --skipLibCheck",
    "bench": "vitest bench --run"
  },
  "resolutions": {
    "unauth": "link:."
  },
  "dependencies": {
    "hookable": "^5.5.3",
    "unjwt": "^0.5.26",
    "unsecure": "^0.0.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.0.8",
    "automd": "^0.4.2",
    "changelogen": "^0.6.2",
    "cookie-esv1": "npm:cookie-es@^1.2.2",
    "cookie-esv2": "npm:cookie-es@^2.0.0",
    "eslint": "^9.39.1",
    "eslint-config-unjs": "^0.5.0",
    "h3v1": "npm:h3@^1.15.4",
    "h3v2": "npm:h3@^2.0.1-rc.5",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.0.8"
  },
  "peerDependencies": {
    "cookie-es": "^1.2.2 || ^2.0.0",
    "h3": "^1.15.4 || >=2.0.1-rc.5 || ^2.0.1",
    "rou3": "^0.7.10"
  },
  "peerDependenciesMeta": {
    "cookie-es": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "rou3": {
      "optional": true
    }
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher"
    ]
  },
  "packageManager": "pnpm@10.18.3"
}
