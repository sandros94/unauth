# Nuxt derives the session and flow keys from `appSecret` (HKDF). `nuxt dev` generates one when
# unset; a build needs it: NUXT_APP_SECRET=$(openssl rand -base64 32)
NUXT_APP_SECRET=

# A GitHub OAuth app whose callback URL is ${NUXT_PUBLIC_ORIGIN}/auth/github
NUXT_GITHUB_CLIENT_ID=
NUXT_GITHUB_CLIENT_SECRET=
NUXT_PUBLIC_ORIGIN=http://localhost:3000
